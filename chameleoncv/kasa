<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Каса</title>
<style>
:root{--bg-dark:#0d1117;--bg-card:#161b22;--bg-card-hover:#1c2128;--btn:#21262d;--btn-hover:#30363d;--accent:#2f81f7;--accent-emph:#1f6feb;--accent-subtle:#388bfd26;--success:#3fb950;--success-emph:#238636;--success-hover:#2ea043;--danger:#f85149;--danger-emph:#da3633;--text:#e6edf3;--text-dim:#8b949e;--text-muted:#7d8590;--border:#30363d}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,Helvetica,sans-serif;background:var(--bg-dark);color:var(--text);line-height:1.5;padding:0 10px 60px}
.container{width:100%;margin:0 auto}
h1{font-size:1.4rem;font-weight:600;margin:14px 0 10px}
h2{font-size:1rem;font-weight:600}
button{font:inherit;cursor:pointer;border:1px solid #f0f6fc1a;background:var(--btn);color:var(--text);border-radius:6px;padding:9px 12px;font-size:.88rem;font-weight:600;transition:background .15s,border-color .15s}
button:hover{background:var(--btn-hover);border-color:#8b949e}
button:active{transform:scale(.97)}
button:disabled{opacity:.45;cursor:not-allowed;transform:none}
.primary{background:var(--success-emph);color:#fff}
.primary:hover:not(:disabled){background:var(--success-hover);border-color:#f0f6fc1a}
.blue{background:var(--accent-emph);color:#fff}
.blue:hover{background:#388bfd;border-color:#f0f6fc1a}
.danger{color:var(--danger)}
.danger:hover{background:var(--danger-emph);border-color:#f0f6fc1a;color:#fff}
.card{background:var(--bg-card);border:1px solid var(--border);border-radius:6px;padding:12px 10px}
.balances{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.balances .lbl{font-size:.8rem;color:var(--text-dim)}
.balances .val{font-size:1.4rem;font-weight:600}
.bar{position:sticky;top:0;z-index:5;background:var(--bg-dark);padding:8px 0 10px;margin-top:10px;border-bottom:1px solid var(--border);display:flex;gap:6px}
.bar .grow{flex:1}
.main{display:grid;grid-template-columns:1fr;gap:14px;margin-top:14px}
@media(min-width:760px){.main{grid-template-columns:3fr 2fr;align-items:stretch}}
.cats{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:10px 0}
@media(min-width:760px){.cats{grid-template-columns:repeat(4,1fr)}}
.rc-head,.rc-row{display:grid;grid-template-columns:1fr 78px 36px 86px;gap:6px;padding:8px 0;border-bottom:1px solid var(--border);font-size:.85rem}
.rc-head{color:var(--text-dim);font-size:.78rem}
.rc-head span:nth-child(n+2),.rc-row span:nth-child(n+2){text-align:right}
.calc-row{display:flex;align-items:center;gap:8px;padding:4px 0}
.calc-row .nom{width:70px;font-weight:600}
.calc-row .name-input{padding:6px 10px;font-size:1rem}
.calc-row .sm{width:100px;text-align:right}
.actions{flex-wrap:wrap}
.actions.three{display:grid;grid-template-columns:repeat(3,1fr)}
.actions.three button{width:100%}
.disc{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.disc .sz{padding:10px 6px}
.disc .name-input{padding:8px;font-size:1rem}
.hist-row{display:grid;grid-template-columns:1fr auto 90px;gap:8px;width:100%;text-align:left;margin-bottom:6px;background:var(--bg-dark);border-color:var(--border);font-weight:400;align-items:center}
.hist-row:hover{background:var(--bg-card-hover)}
.hist-row b{text-align:right;font-weight:600}
#closeDlg{width:min(540px,94vw)}
@media(max-width:520px){.actions.three{grid-template-columns:1fr}}
.sz{padding:16px 6px;border-radius:6px;background:var(--bg-dark);border:1px solid var(--border);color:var(--text-muted);text-align:center;font-size:.95rem;font-weight:600;cursor:pointer;transition:background .15s,border-color .15s}
.sz:hover{background:var(--bg-card-hover);border-color:var(--border)}
.sz.on{background:var(--accent-subtle);border-color:#388bfd;color:var(--text)}
.row{display:flex;gap:6px}
.name-input{flex:1;min-width:0;font:inherit;font-size:1.1rem;font-weight:600;color:var(--text);background:var(--bg-dark);border:1px solid var(--border);border-radius:6px;padding:10px}
.name-input:focus{outline:none;border-color:var(--accent-emph);box-shadow:0 0 0 3px #1f6feb4d}
.name-input::placeholder{color:var(--text-muted);font-weight:400}
.dim{color:var(--text-dim);font-size:.85rem}
.empty{text-align:center;color:var(--text-dim);padding:18px 0;border-bottom:1px solid var(--border)}
.item{display:flex;align-items:center;gap:8px;padding:10px 0;border-bottom:1px solid var(--border)}
.item .nm{flex:1;min-width:0}
.item .nm b{display:block;font-weight:600}
.qty{display:flex;align-items:center;gap:4px}
.qty button{width:34px;padding:6px 0;font-size:1rem}
.qty span{min-width:24px;text-align:center;font-weight:600}
.item .sum{min-width:70px;text-align:right;font-weight:600}
.totals{display:flex;justify-content:space-between;font-weight:600;padding:12px 0 4px;font-size:1.1rem}
.pay{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:12px 0}
.cash-box{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.change{display:flex;flex-direction:column;justify-content:center;padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--bg-dark)}
.change b{font-size:1.1rem;font-weight:600;color:var(--success)}
.change b.bad{color:var(--danger)}
#issue{width:100%;padding:13px;font-size:1rem}
dialog{margin:auto;background:var(--bg-card);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:16px;width:min(440px,94vw);max-height:92vh;overflow:auto}
dialog::backdrop{background:#010409b3}
dialog h2{margin-bottom:10px}
.line{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border)}
.line.total{font-weight:600;border-bottom:0}
.actions{display:flex;gap:6px;margin-top:14px;justify-content:flex-end}
a{color:var(--accent)}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--success);color:var(--bg-dark);padding:9px 18px;border-radius:20px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .25s;z-index:20}
#toast.show{opacity:1}
</style>
</head>
<body>
<div class="container">
  <h1>Продаж товару</h1>
  <div class="balances">
    <div class="card"><div class="lbl">Готівковий баланс</div><div class="val" id="balCash">0.00 ₴</div></div>
    <div class="card"><div class="lbl">Безготівковий баланс (картка)</div><div class="val" id="balCard">0.00 ₴</div></div>
  </div>
  <div class="bar">
    <span class="grow"></span>
    <button id="xBtn">Х-звіт</button>
    <button id="calcBtn">Калькулятор готівки</button>
    <button id="histBtn">Історія чеків</button>
    <button id="closeBtn" class="danger">Закрити зміну</button>
  </div>

  <div class="main">
    <section class="card">
      <h2>Новий товар</h2>
      <div class="cats" id="cats"></div>
      <div class="row">
        <input class="name-input" id="price" type="text" inputmode="decimal" placeholder="Ціна, ₴" autocomplete="off">
        <button class="blue" id="addBtn">Додати</button>
      </div>
    </section>

    <section class="card">
      <h2>Чек</h2>
      <div id="cart"></div>
      <div class="dim" style="margin:12px 0 6px">Знижка на чек</div>
      <div class="disc" id="disc"><button class="sz" data-d="0">0%</button><button class="sz" data-d="5">5%</button><button class="sz" data-d="10">10%</button><input class="name-input" id="custom" type="text" inputmode="decimal" placeholder="Інша, %" autocomplete="off"></div>
      <div class="line" id="discLine" style="display:none"><span>Знижка</span><span id="discAmt"></span></div>
      <div class="totals"><span>До сплати:</span><span id="total">0.00 ₴</span></div>
      <div class="pay">
        <button class="sz on" id="payCash">Готівка</button>
        <button class="sz" id="payCard">Картка</button>
      </div>
      <div class="cash-box" id="cashBox">
        <input class="name-input" id="given" type="text" inputmode="decimal" placeholder="Дав покупець, ₴" autocomplete="off">
        <div class="change"><span class="dim">Решта</span><b id="change">0.00 ₴</b></div>
      </div>
      <button class="primary" id="issue" disabled>Видати чек</button>
    </section>
  </div>
</div>

<dialog id="xDlg">
  <h2>Х-звіт</h2>
  <div class="dim" style="margin-bottom:6px">Виручка</div>
  <div class="line"><span>Готівка</span><span id="xCash"></span></div>
  <div class="line"><span>Безготівка (картка)</span><span id="xCard"></span></div>
  <div class="line total"><span>Всього</span><span id="xAll"></span></div>
  <div class="actions"><button id="xOk">Закрити</button></div>
</dialog>

<dialog id="closeDlg">
  <h2>Закрити зміну?</h2>
  <p class="dim">Усі продажі та поточний чек будуть очищені, готівка поверне початкові 1000 ₴. Дію не можна скасувати.</p>
  <div class="actions three"><button id="closeCopy" class="blue">Скопіювати звіт</button><button id="closeNo">Скасувати</button><button id="closeYes" class="danger">Закрити зміну</button></div>
</dialog>

<dialog id="rcDlg">
  <h2 id="rcTitle">Чек</h2>
  <div id="rcBody"></div>
  <div class="actions"><button id="rcDel" class="danger" style="display:none">Скасувати чек</button><button id="rcOk">Закрити</button><button id="rcCopy" class="primary">Скопіювати чек</button></div>
</dialog>

<dialog id="histDlg">
  <h2>Історія чеків</h2>
  <div class="dim" id="histCount" style="margin-bottom:8px"></div>
  <div id="histList"></div>
  <div class="actions"><button id="histOk">Закрити</button></div>
</dialog>

<dialog id="calcDlg">
  <h2>Калькулятор готівки</h2>
  <div id="calcList"></div>
  <div class="line total"><span>Всього</span><span id="calcTotal">0.00 ₴</span></div>
  <div class="actions"><button id="calcReset">Скинути</button><button id="calcOk">Закрити</button></div>
</dialog>

<div id="toast"></div>

<script>
const FLOAT=1000, CATS=['Нижня білизна','Шкарпетки','Окуляри','Аксесуари'], KEY='kasa-v1';
let st={sales:[],cart:[],cat:null,pay:'cash',disc:0};
try{const s=JSON.parse(localStorage.getItem(KEY));if(s&&Array.isArray(s.sales)&&Array.isArray(s.cart))st=Object.assign(st,s)}catch(e){}
const $=id=>document.getElementById(id);
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(st))}catch(e){}};
const fmt=n=>n.toLocaleString('uk-UA',{minimumFractionDigits:2,maximumFractionDigits:2})+' ₴';
const num=v=>{const n=parseFloat(String(v).replace(',','.'));return isFinite(n)&&n>0?Math.round(n*100)/100:0};
const sub=()=>st.cart.reduce((s,i)=>s+i.price*i.qty,0);
const total=()=>Math.round(sub()*(1-(st.disc||0)/100)*100)/100;
const sum=m=>st.sales.filter(s=>s.pay===m).reduce((a,s)=>a+s.total,0);
let tt;function toast(t){const e=$('toast');e.textContent=t;e.classList.add('show');clearTimeout(tt);tt=setTimeout(()=>e.classList.remove('show'),1400)}

function render(){
  $('cats').innerHTML=CATS.map((c,i)=>`<button class="sz${(st.cat||CATS[0])===c?' on':''}" data-c="${i}">${c}</button>`).join('');
  $('balCash').textContent=fmt(FLOAT+sum('cash'));
  $('balCard').textContent=fmt(sum('card'));
  $('cart').innerHTML=st.cart.length?st.cart.map((i,x)=>`<div class="item"><div class="nm"><b>${i.cat}</b><span class="dim">${fmt(i.price)}</span></div><div class="qty"><button data-m="${x}">−</button><span>${i.qty}</span><button data-p="${x}">＋</button></div><div class="sum">${fmt(i.price*i.qty)}</div></div>`).join(''):'<div class="empty">Чек поки що порожній</div>';
  const t=total();$('total').textContent=fmt(t);
  const d=st.disc||0,cu=$('custom').value.trim();
  document.querySelectorAll('#disc [data-d]').forEach(b=>b.classList.toggle('on',!cu&&+b.dataset.d===d));
  $('custom').style.borderColor=cu?'#388bfd':'';
  $('discLine').style.display=d?'flex':'none';$('discAmt').textContent=d+'%: −'+fmt(sub()-t);
  $('payCash').classList.toggle('on',st.pay==='cash');
  $('payCard').classList.toggle('on',st.pay==='card');
  $('cashBox').style.display=st.pay==='cash'?'grid':'none';
  const g=num($('given').value),ch=g-t;
  const el=$('change');el.textContent=g?fmt(Math.max(ch,0)):fmt(0);
  if(g&&ch<0){el.textContent='Не вистачає '+fmt(-ch);el.classList.add('bad')}else el.classList.remove('bad');
  $('issue').disabled=!t||(st.pay==='cash'&&g<t);
}
function add(){
  const cat=st.cat||CATS[0];
  const p=num($('price').value);if(!p){toast('Введіть ціну');$('price').focus();return}
  const f=st.cart.find(i=>i.cat===cat&&i.price===p);
  f?f.qty++:st.cart.push({cat,price:p,qty:1});
  $('price').value='';save();render();$('price').focus();
}
$('cats').onclick=e=>{const b=e.target.closest('[data-c]');if(!b)return;st.cat=CATS[b.dataset.c];save();render();$('price').focus()};
$('addBtn').onclick=add;
$('price').onkeydown=e=>{if(e.key==='Enter')add()};
$('given').oninput=render;
$('disc').onclick=e=>{const b=e.target.closest('[data-d]');if(!b)return;st.disc=+b.dataset.d;$('custom').value='';save();render()};
$('custom').oninput=()=>{const n=parseFloat($('custom').value.replace(',','.'));st.disc=isFinite(n)?Math.min(Math.max(n,0),99):0;save();render()};
if(![0,5,10].includes(st.disc||0))$('custom').value=st.disc;
$('cart').onclick=e=>{
  const m=e.target.closest('[data-m]'),p=e.target.closest('[data-p]');
  if(p)st.cart[p.dataset.p].qty++;
  else if(m){const i=st.cart[m.dataset.m];if(--i.qty<=0)st.cart.splice(m.dataset.m,1)}
  else return;
  save();render();
};
$('payCash').onclick=()=>{st.pay='cash';save();render()};
$('payCard').onclick=()=>{st.pay='card';save();render()};
$('issue').onclick=()=>{
  const t=total();if(!t)return;
  const sale={n:(st.n=(st.n||0)+1),total:t,sub:sub(),disc:st.disc||0,pay:st.pay,items:st.cart,time:Date.now()};st.sales.push(sale);
  const ch=st.pay==='cash'?num($('given').value)-t:0;
  st.cart=[];st.disc=0;$('custom').value='';$('given').value='';save();render();
  showReceipt(sale);
};
$('xBtn').onclick=()=>{const c=sum('cash'),d=sum('card');$('xCash').textContent=fmt(c);$('xCard').textContent=fmt(d);$('xAll').textContent=fmt(c+d);$('xDlg').showModal()};
$('xOk').onclick=()=>$('xDlg').close();
function copy(t,msg){const done=()=>toast(msg);const fb=()=>{const a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();try{document.execCommand('copy');done()}catch(e){toast('Не вдалося скопіювати')}a.remove()};if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).then(done,fb);else fb()}
const reportText=()=>{const c=sum('cash'),d=sum('card');return 'Загальний звіт за '+new Date().toLocaleDateString('uk-UA')+'\nГотівка: '+fmt(c)+'\nБезготівка (картка): '+fmt(d)+'\nВсього: '+fmt(c+d)};
$('closeCopy').onclick=()=>copy(reportText(),'Звіт скопійовано');
const f2=n=>fmt(n).replace(' ₴','');
const payName=p=>p==='cash'?'Готівка':'Безготівка';
let lastText='';
let curSale=null,delArm=0;
function showReceipt(s,h){
  curSale=s;delArm=0;$('rcDel').textContent='Скасувати чек';$('rcDel').style.display=h?'':'none';$('rcTitle').textContent=s.n?'Чек №'+s.n:'Чек';
  $('rcBody').innerHTML='<div class="rc-head"><span>Назва</span><span>Ціна</span><span>К-сть</span><span>Сума</span></div>'+s.items.map(i=>`<div class="rc-row"><span>${i.cat}</span><span>${f2(i.price)}</span><span>${i.qty}</span><span>${f2(i.price*i.qty)}</span></div>`).join('')+(s.disc?`<div class="line"><span>Сума</span><span>${fmt(s.sub)}</span></div><div class="line"><span>Знижка ${s.disc}%</span><span>−${fmt(s.sub-s.total)}</span></div>`:'')+`<div class="line total"><span>Всього</span><span>${fmt(s.total)}</span></div><div class="line"><span>Тип оплати</span><span>${payName(s.pay)}</span></div>`;
  lastText=s.items.map(i=>i.qty===1?`${i.cat} - ${f2(i.price)}`:`${i.cat} - ${f2(i.price)} x ${i.qty} = ${f2(i.price*i.qty)}`).join('\n')+(s.disc?'\nЗнижка '+s.disc+'%: −'+fmt(s.sub-s.total):'')+'\nВсього: '+fmt(s.total)+'\nТип оплати: '+payName(s.pay);
  $('rcDlg').showModal();
}
$('rcCopy').onclick=()=>copy(lastText,'Чек скопійовано');
$('rcOk').onclick=()=>$('rcDlg').close();
function renderHist(){
  st.sales.forEach((s,i)=>{if(!s.n)s.n=i+1});
  $('histCount').textContent=st.sales.length?'Чеків за зміну: '+st.sales.length:'';
  $('histList').innerHTML=st.sales.length?st.sales.map((s,i)=>`<button class="hist-row" data-i="${i}"><span>№${s.n} · ${new Date(s.time).toLocaleTimeString('uk-UA',{hour:'2-digit',minute:'2-digit'})}</span><span class="dim">${payName(s.pay)}</span><b>${fmt(s.total)}</b></button>`).reverse().join(''):'<div class="empty">Чеків поки що немає</div>';
}
$('histBtn').onclick=()=>{renderHist();$('histDlg').showModal()};
$('histOk').onclick=()=>$('histDlg').close();
$('histList').onclick=e=>{const b=e.target.closest('[data-i]');if(!b)return;showReceipt(st.sales[b.dataset.i],true)};
$('rcDel').onclick=()=>{
  if(!delArm){delArm=1;$('rcDel').textContent='Підтвердити скасування';setTimeout(()=>{delArm=0;$('rcDel').textContent='Скасувати чек'},3000);return}
  st.sales=st.sales.filter(x=>x!==curSale);delArm=0;save();render();renderHist();$('rcDlg').close();toast('Чек скасовано');
};
const NOM=[1,2,5,10,20,50,100,200,500,1000,2000];
$('calcList').innerHTML=NOM.map(n=>`<div class="calc-row"><span class="nom">${n} ₴</span><input class="name-input" data-n="${n}" type="text" inputmode="numeric" placeholder="0" autocomplete="off"><span class="sm dim">0 ₴</span></div>`).join('');
function calc(){let t=0;document.querySelectorAll('#calcList input').forEach(e=>{const s=Math.floor(num(e.value))*e.dataset.n;t+=s;e.nextElementSibling.textContent=s.toLocaleString('uk-UA')+' ₴'});$('calcTotal').textContent=fmt(t)}
$('calcList').oninput=calc;
$('calcBtn').onclick=()=>$('calcDlg').showModal();
$('calcReset').onclick=()=>{document.querySelectorAll('#calcList input').forEach(e=>e.value='');calc()};
$('calcOk').onclick=()=>$('calcDlg').close();
$('closeBtn').onclick=()=>$('closeDlg').showModal();
$('closeNo').onclick=()=>$('closeDlg').close();
$('closeYes').onclick=()=>{st={sales:[],cart:[],cat:null,pay:'cash',disc:0};$('custom').value='';$('given').value='';$('price').value='';save();render();$('closeDlg').close();toast('Зміну закрито')};
render();
</script>
</body>
</html>
